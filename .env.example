PORT=3009
MODELS_DIR=./models
# Nama file di MODELS_DIR (offline). Unduh dulu dengan: npm run model:pull
MODEL_URI=lfm2-350m-q8_0.gguf
# Jumlah thread = jumlah vCPU VPS. Jangan lebih.
THREADS=2
# letter = cepat (1 huruf), full = "huruf) teks"
ANSWER_MODE=letter
USE_GRAMMAR=true
# 0 = soal yang sama selalu dapat jawaban yang sama. > 0 = jawaban bisa berbeda tiap request (makin tinggi makin acak)
# Temperature saat request TANPA kunci jawaban
TEMPERATURE=2
# Temperature saat request DENGAN kunci jawaban (0 = selalu ikut kunci)
ANSWER_KEY_TEMPERATURE=0
MAX_TOKENS=32
